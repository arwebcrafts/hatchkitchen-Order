{
  "version": 2,
  "name": "hatch-kitchen",
  "routes": [
    {
      "src": "/api/create-payment-intent",
      "dest": "/api/create-payment-intent.js"
    },
    {
      "src": "/api/notify-order",
      "dest": "/api/notify-order.js"
    },
    {
      "src": "/api/admin-auth",
      "dest": "/api/admin-auth.js"
    },
    {
      "src": "/api/admin-orders",
      "dest": "/api/admin-orders.js"
    },
    {
      "src": "/api/admin-order-action",
      "dest": "/api/admin-order-action.js"
    },
    {
      "src": "/api/admin-abandoned",
      "dest": "/api/admin-abandoned.js"
    },
    {
      "src": "/api/save-abandoned-order",
      "dest": "/api/save-abandoned-order.js"
    },
    {
      "src": "/api/(.*)\\.js",
      "dest": "/api/$1.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|site\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
